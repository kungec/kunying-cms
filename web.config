<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="detail2" stopProcessing="true">
          <match url="^detail-([0-9]+)-([0-9]+)\.html$" ignoreCase="false"/>
          <action type="Rewrite" url="index.php?s=/vod/detail&amp;id={R:1}&amp;ep={R:2}"/>
        </rule>
        <rule name="detail" stopProcessing="true">
          <match url="^detail-([0-9]+)\.html$" ignoreCase="false"/>
          <action type="Rewrite" url="index.php?s=/vod/detail&amp;id={R:1}"/>
        </rule>
      </rules>
    </rewrite>
    <!-- 安全:核心代码/数据/备份/.git目录与敏感文件一律404(数据库备份在data/backup,必须拦) -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="ky"/>
          <add segment="data"/>
          <add segment="docker"/>
          <add segment="docs"/>
          <add segment=".git"/>
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".sql" allowed="false"/>
          <add fileExtension=".gz" allowed="false"/>
          <add fileExtension=".log" allowed="false"/>
          <add fileExtension=".sh" allowed="false"/>
          <add fileExtension=".lock" allowed="false"/>
          <add fileExtension=".yml" allowed="false"/>
          <add fileExtension=".ini" allowed="false"/>
          <add fileExtension=".bak" allowed="false"/>
        </fileExtensions>
      </requestFiltering>
    </security>
    <!-- 根目录文档/容器配置不对外 -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By"/>
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
