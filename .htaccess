# 坤影CMS Apache伪静态与安全规则
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(ky|data|docker|docs)(/|$) - [F,L]
RewriteRule ^(theme|addon)/.*\.php$ - [F,L]
# 隐藏文件(.git等,.well-known除外)
RewriteRule (^|/)\.(?!well-known) - [F,L]
# 根目录敏感文件(备份/日志/文档/容器配置)
RewriteRule ^[^/]+\.(sql|gz|log|sh|lock|yml|yaml|ini|bak|md)$ - [F,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?s=/$1 [QSA,PT,L]
</IfModule>
